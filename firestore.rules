rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, create, update, delete: if false;
    }

    // Validation for a user base document. The browser may only create
    // non-privileged profiles; admin access comes from a trusted claim.
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'coverURL', 'role', 'bio', 'createdAt', 'updatedAt', 'firstName', 'lastName', 'phone', 'id', 'status', 'isRegistered']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        request.auth.token.email == data.email &&
        (!('role' in data) || data.role in ['player', 'coach', 'academy', 'admin']);
    }

    function isValidInitialUser(data) {
      return isValidUser(data) &&
        (!('role' in data) || data.role in ['player', 'coach', 'academy']);
    }

    // Validation for Player profile
    function isValidPlayer(data) {
      return data.keys().hasAll(['uid', 'firstName', 'lastName', 'foot', 'position']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.firstName is string && data.firstName.size() <= 50 &&
        data.lastName is string && data.lastName.size() <= 50 &&
        data.foot in ['يمنى', 'يسرى'] &&
        data.position is string && data.position.size() <= 50;
    }

    // Validation for Coach profile
    function isValidCoach(data) {
      return data.keys().hasAll(['uid', 'firstName', 'lastName', 'title']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.firstName is string && data.firstName.size() <= 50 &&
        data.lastName is string && data.lastName.size() <= 50 &&
        data.title is string && data.title.size() <= 100;
    }

    // Validation for Academy
    function isValidAcademy(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'price']) &&
        data.id is string && data.ownerUid is string &&
        data.name is string && data.name.size() <= 100 &&
        data.price is number && data.price >= 0;
    }

    function isValidNewAcademy(data) {
      return isValidAcademy(data) &&
        data.keys().hasOnly(['id', 'ownerUid', 'name', 'photoURL', 'coverURL', 'bio', 'governorate', 'city', 'address', 'mapUrl', 'price', 'spots', 'cap', 'minAge', 'maxAge', 'rate', 'reviewsCount', 'categories', 'plans', 'formerPlayers', 'createdAt', 'updatedAt']);
    }

    function isValidAcademyUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'coverURL', 'bio', 'governorate', 'city', 'address', 'mapUrl', 'price', 'spots', 'cap', 'minAge', 'maxAge', 'categories', 'plans', 'formerPlayers', 'updatedAt']) &&
        isValidAcademy(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid;
    }

    // Validation for Post
    function isValidPost(data) {
      return data.keys().hasAll(['id', 'authorUid', 'authorName', 'text']) &&
        data.keys().hasOnly(['id', 'authorUid', 'authorName', 'authorPhoto', 'role', 'text', 'media', 'mediaUrls', 'score', 'likesCount', 'commentsCount', 'sharesCount', 'audience', 'allowComments', 'createdAt', 'updatedAt']) &&
        data.authorUid is string && data.authorUid == request.auth.uid &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.text is string && data.text.size() <= 2000 &&
        (!('media' in data) || data.media is string) &&
        (!('mediaUrls' in data) || (data.mediaUrls is list && data.mediaUrls.size() <= 4)) &&
        (!('audience' in data) || data.audience in ['all', 'fol', 'me']) &&
        (!('allowComments' in data) || data.allowComments is bool);
    }

    // Validation for Booking
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userUid', 'academyId', 'date', 'status']) &&
        data.keys().hasOnly(['id', 'userUid', 'academyId', 'date', 'status', 'planKey', 'planName', 'amount', 'createdAt', 'updatedAt']) &&
        data.userUid is string && data.userUid == request.auth.uid &&
        data.academyId is string && data.academyId.size() <= 128 &&
        data.date is string && data.date.size() <= 30 &&
        data.status in ['pending', 'confirmed', 'cancelled'] &&
        (!('amount' in data) || (data.amount is number && data.amount >= 0));
    }

    function isAcademyOwner(academyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/academies/$(academyId)) &&
        get(/databases/$(database)/documents/academies/$(academyId)).data.ownerUid == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidInitialUser(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverURL', 'bio', 'role', 'createdAt', 'updatedAt']) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          ((!('role' in existing()) &&
            (!('role' in incoming()) || incoming().role in ['player', 'coach', 'academy'])) ||
           ('role' in existing() && 'role' in incoming() && incoming().role == existing().role)) &&
          (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt)
        ) ||
        (isAdmin() && isValidUser(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverURL', 'bio', 'role', 'createdAt', 'updatedAt', 'status', 'isRegistered']) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email)
      );
      allow delete: if isAdmin();
    }

    // Public profile projection. Private email, address, and birth data stay in protected collections.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && (isAdmin() || isOwner(userId)) &&
        incoming().keys().hasOnly(['uid', 'displayName', 'photoURL', 'coverURL', 'bio', 'role', 'updatedAt']) &&
        incoming().uid == userId &&
        (incoming().role in ['player', 'coach', 'academy'] ||
          (incoming().role == 'admin' && isAdmin()));
      allow update: if isSignedIn() && (isAdmin() || isOwner(userId)) &&
        incoming().keys().hasOnly(['uid', 'displayName', 'photoURL', 'coverURL', 'bio', 'role', 'updatedAt']) &&
        incoming().uid == userId &&
        (isAdmin() || (incoming().role in ['player', 'coach', 'academy'] &&
          (!('role' in existing()) || incoming().role == existing().role)));
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Players Collection
    match /players/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidPlayer(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidPlayer(incoming()) && incoming().uid == existing().uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Coaches Collection
    match /coaches/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidCoach(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidCoach(incoming()) && incoming().uid == existing().uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Academies Collection
    match /academies/{academyId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidNewAcademy(incoming()) &&
        incoming().id == academyId &&
        ((academyId == request.auth.uid && incoming().ownerUid == request.auth.uid) || isAdmin());
      allow update: if isSignedIn() && (
        (existing().ownerUid == request.auth.uid && isValidAcademyUpdate()) ||
        (isAdmin() && isValidAcademyUpdate())
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);
    }

    // Posts Collection
    match /posts/{postId} {
      allow get: if isSignedIn() &&
        (!('audience' in resource.data) || resource.data.audience == 'all' || resource.data.authorUid == request.auth.uid);
      allow list: if isSignedIn() &&
        (!('audience' in resource.data) || resource.data.audience == 'all' || resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn() && isValidPost(incoming());
      allow update: if isSignedIn() && (
        (existing().authorUid == request.auth.uid && isValidPost(incoming()) && incoming().authorUid == existing().authorUid) ||
        // Action: Like/Unlike count increment
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) &&
          incoming().likesCount is number && incoming().likesCount >= 0 &&
          (incoming().likesCount == existing().likesCount + 1 || incoming().likesCount == existing().likesCount - 1) &&
          ((incoming().likesCount == existing().likesCount + 1 &&
            getAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)).data.uid == request.auth.uid) ||
           (incoming().likesCount == existing().likesCount - 1 &&
            !existsAfter(/databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))) &&
          isValidId(postId)) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount']) &&
          incoming().commentsCount is number && incoming().commentsCount == existing().commentsCount + 1 &&
          isValidId(postId)) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);

      // Subcollection: Likes
      match /likes/{userId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && isOwner(userId) &&
          incoming().keys().hasOnly(['uid', 'createdAt']) &&
          incoming().uid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && isOwner(userId);
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow get, list: if isSignedIn() &&
          (!('audience' in get(/databases/$(database)/documents/posts/$(postId)).data) ||
            get(/databases/$(database)/documents/posts/$(postId)).data.audience == 'all' ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorUid == request.auth.uid);
        allow create: if isSignedIn() &&
          incoming().keys().hasAll(['authorUid', 'authorName', 'text', 'createdAt']) &&
          incoming().keys().hasOnly(['authorUid', 'authorName', 'authorPhoto', 'text', 'parentCommentId', 'likesCount', 'createdAt']) &&
          incoming().authorUid == request.auth.uid &&
          incoming().authorName is string && incoming().authorName.size() <= 100 &&
          incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000;
        allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']) &&
          incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 1000 &&
          incoming().authorUid == existing().authorUid;
        allow delete: if isSignedIn() &&
          (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // Stories
    match /stories/{storyId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
        storyId == request.auth.uid &&
        incoming().keys().hasAll(['id', 'authorUid', 'authorName', 'image', 'createdAt', 'expiresAt']) &&
        incoming().keys().hasOnly(['id', 'authorUid', 'authorName', 'authorPhoto', 'image', 'createdAt', 'expiresAt', 'updatedAt']) &&
        incoming().id == storyId &&
        incoming().authorUid == request.auth.uid &&
        incoming().authorName is string && incoming().authorName.size() <= 100 &&
        incoming().image is string && incoming().image.size() <= 900000 &&
        incoming().expiresAt is timestamp;
      allow update: if isSignedIn() &&
        resource.data.authorUid == request.auth.uid &&
        incoming().authorUid == resource.data.authorUid &&
        incoming().image is string && incoming().image.size() <= 900000 &&
        incoming().expiresAt is timestamp;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming()) &&
        incoming().userUid == request.auth.uid &&
        incoming().status == 'pending' &&
        !('amount' in incoming()) &&
        ('planKey' in incoming() && incoming().planKey in ['m', 'q', 'y']) &&
        exists(/databases/$(database)/documents/academies/$(incoming().academyId));
      allow update: if isSignedIn() && (
        (existing().userUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          existing().status == 'pending' &&
          incoming().status == 'cancelled') ||
        (isAcademyOwner(existing().academyId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status in ['confirmed', 'cancelled']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.userUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userUid == request.auth.uid;
    }

    // Test connection doc
    match /test/{docId} {
      allow get: if true;
    }
  }
}

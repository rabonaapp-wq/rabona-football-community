rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'rabonaapp@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for User base doc
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'coverURL', 'role', 'bio', 'createdAt', 'updatedAt', 'firstName', 'lastName', 'phone', 'id', 'status', 'isRegistered']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('role' in data) || data.role in ['player', 'coach', 'academy', 'admin']);
    }

    // Validation for Player profile
    function isValidPlayer(data) {
      return data.keys().hasAll(['uid', 'firstName', 'lastName', 'foot', 'position']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.firstName is string && data.firstName.size() <= 50 &&
        data.lastName is string && data.lastName.size() <= 50 &&
        data.foot in ['يمنى', 'يسرى'] &&
        data.position is string && data.position.size() <= 50;
    }

    // Validation for Coach profile
    function isValidCoach(data) {
      return data.keys().hasAll(['uid', 'firstName', 'lastName', 'title']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.firstName is string && data.firstName.size() <= 50 &&
        data.lastName is string && data.lastName.size() <= 50 &&
        data.title is string && data.title.size() <= 100;
    }

    // Validation for Academy
    function isValidAcademy(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'price']) &&
        data.ownerUid is string && data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() <= 100 &&
        data.price is number && data.price >= 0;
    }

    // Validation for Post
    function isValidPost(data) {
      return data.keys().hasAll(['id', 'authorUid', 'authorName', 'text']) &&
        data.authorUid is string && data.authorUid == request.auth.uid &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.text is string && data.text.size() <= 2000;
    }

    // Validation for Booking
    function isValidBooking(data) {
      return data.keys().hasAll(['id', 'userUid', 'academyId', 'date']) &&
        data.userUid is string && data.userUid == request.auth.uid &&
        data.academyId is string && data.academyId.size() <= 128 &&
        data.date is string && data.date.size() <= 30;
    }

    // Validation for Order
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userUid', 'items', 'totalAmount']) &&
        data.userUid is string && data.userUid == request.auth.uid &&
        data.items is list && data.items.size() <= 50 &&
        data.totalAmount is number && data.totalAmount >= 0;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming()) &&
          (!('uid' in existing()) || incoming().uid == existing().uid) &&
          (!('role' in existing()) || !('role' in incoming()) || incoming().role == existing().role)
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Players Collection
    match /players/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidPlayer(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidPlayer(incoming()) && incoming().uid == existing().uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Coaches Collection
    match /coaches/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(userId) && isValidCoach(incoming());
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidCoach(incoming()) && incoming().uid == existing().uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Academies Collection
    match /academies/{academyId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidAcademy(incoming()) && (incoming().ownerUid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (
        (existing().ownerUid == request.auth.uid && isValidAcademy(incoming()) && incoming().ownerUid == existing().ownerUid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);
    }

    // Posts Collection
    match /posts/{postId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidPost(incoming());
      allow update: if isSignedIn() && (
        (existing().authorUid == request.auth.uid && isValidPost(incoming()) && incoming().authorUid == existing().authorUid) ||
        // Action: Like/Unlike count increment
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'updatedAt']) && isValidId(postId)) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid);

      // Subcollection: Likes
      match /likes/{userId} {
        allow get: if true;
        allow list: if true;
        allow create, update: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        (existing().userUid == request.auth.uid && isValidBooking(incoming()) && incoming().userUid == existing().userUid) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userUid == request.auth.uid);
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() || isSignedIn();
      allow update: if isSignedIn() && resource.data.userUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userUid == request.auth.uid;
    }

    // Test connection doc
    match /test/{docId} {
      allow get: if true;
    }
  }
}
